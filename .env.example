# Server
PORT=3001
NODE_ENV=production
JWT_SECRET=<generate-a-random-64-char-string>

# Database
DATABASE_URL=postgresql://tesseraflow:password@localhost:5432/tesseraflow

# Optional: Override individual PG vars
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=tesseraflow
# PGUSER=tesseraflow
# PGPASSWORD=password

# Optional: App URL for Google Calendar OAuth redirect
# APP_URL=https://your-domain.com
